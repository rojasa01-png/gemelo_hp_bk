# Copia este archivo a .env.local (NUNCA subas el .env real a git)
#
# LLAVES QUE NECESITAS
#   Agente B (agent_realtime.py, OpenAI Realtime):
#       LiveKit (3) + Anam + OpenAI + ElevenLabs (llave y voice id)
#   Agente A (agent.py, Claude):
#       LiveKit (3) + Anam + Anthropic + Deepgram + ElevenLabs (llave y voice id)
#   Base44 es opcional en los dos.

# --- LiveKit (cloud.livekit.io > tu proyecto > Settings > Keys) --- [A y B]
LIVEKIT_URL=wss://TU-PROYECTO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Anam (cara) --- [A y B]
ANAM_API_KEY=
ANAM_AVATAR_ID=            # el mismo avatar que ya usas
ANAM_AVATAR_MODEL=cara-4.1-express   # vacío = el modelo por defecto del avatar

# --- Voz de Héctor (ElevenLabs) --- [A y B]
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=       # ID de la voz CLONADA de Héctor en ElevenLabs (no es el ANAM_VOICE_ID)
ELEVENLABS_MODEL=eleven_turbo_v2_5   # prueba eleven_flash_v2_5 si quieres menos latencia

# --- Cerebro del agente B: OpenAI Realtime --- [solo B]
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_TURN_EAGERNESS=auto         # low | medium | high | auto
# OPENAI_REASONING_EFFORT=low        # solo modelos con razonamiento (ej. gpt-realtime-2)

# --- Cerebro del agente A: Claude + Deepgram --- [solo A]
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=300
DEEPGRAM_API_KEY=
STT_LANGUAGE=multi         # "es" si solo hablas español
# STT_KEYTERMS=Tadah,Grupo Scanda,MAIA,Héctor Padilla
# MIN_ENDPOINTING_DELAY=0.5
# MAX_ENDPOINTING_DELAY=3.0
# PREEMPTIVE_GENERATION=false

# --- Conocimiento (Base44), opcional --- [A y B]
BASE44_APP_URL=
BASE44_SERVICE_TOKEN=
BASE44_TIMEOUT_SECONDS=2.0

# --- token_server.py (la página de prueba) ---
FRONTEND_ORIGIN=*          # pon tu dominio real al desplegar
